# The dashboard's image (dashboard-plan.md 11): a Node stage builds the web app, and the UBI nginx image serves it
# unprivileged on 8080 under any UID with GID 0, as OpenShift's restricted profile requires. The event tree is never
# in the image: it is a volume at /srv/data (deploy/base/web.yaml), and config.json comes from a ConfigMap. Build from
# the repository root:
#   podman build -f deploy/Containerfile --build-arg BUILD_COMMIT=$(git rev-parse --short HEAD) -t dashboard:dev .
FROM docker.io/library/node:24-bookworm-slim AS build
WORKDIR /src
COPY . .
# The web app needs no assembler (it never assembles, AGENTS.md), so the install skips the workspace's postinstall,
# which builds it. pnpm at the version package.json pins; its store lives in a build cache mount.
RUN --mount=type=cache,target=/root/.local/share/pnpm,sharing=locked \
    npm install -g "pnpm@$(node -p "require('./package.json').packageManager.split('@')[1]")" \
    && pnpm install --frozen-lockfile --ignore-scripts
ARG BUILD_COMMIT=image
RUN BUILD_COMMIT="$BUILD_COMMIT" pnpm --filter @cwa-dashboard/web build

FROM registry.access.redhat.com/ubi9/nginx-124:latest
# The built app at the image's document root, and the server configuration in the default server's include
# directory (the cluster mounts the same files and ingest-proxy.conf from a ConfigMap over it). An empty tree to mount
# over, and a config for running the image on its own, with no replay service; the cluster and compose mount theirs.
COPY --from=build /src/apps/web/dist/ /opt/app-root/src/
COPY deploy/base/nginx/dashboard.conf deploy/base/nginx/headers.inc /opt/app-root/etc/nginx.default.d/
COPY deploy/image-config.json /opt/app-root/src/config.json
COPY LICENSE NOTICE /licenses/
USER 0
RUN mkdir -p /srv/data && chown -R 1001:0 /srv/data && chmod -R g+rwX /srv/data
USER 1001
EXPOSE 8080
CMD ["/usr/libexec/s2i/run"]
