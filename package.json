{
  "name": "cwa-dashboard",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "description": "The observability and audit plane for Context Window Architecture assemblies",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "VITE_API_TARGET=http://127.0.0.1:8090 pnpm --parallel --filter @cwa-dashboard/ingest --filter @cwa-dashboard/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor": "node packages/contract/scripts/vendor-contract.mjs",
    "vendor:check": "node packages/contract/scripts/vendor-contract.mjs --check",
    "generate": "pnpm -r generate",
    "postinstall": "node packages/assembler/scripts/build.mjs",
    "build:assembler": "node packages/assembler/scripts/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
