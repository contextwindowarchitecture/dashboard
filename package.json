{
  "name": "cwa-dashboard",
  "private": true,
  "version": "0.0.0",
  "description": "The observability and audit plane for Context Window Architecture assemblies",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor": "node packages/contract/scripts/vendor-contract.mjs",
    "vendor:check": "node packages/contract/scripts/vendor-contract.mjs --check",
    "generate": "pnpm -r generate"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
