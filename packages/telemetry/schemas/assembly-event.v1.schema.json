{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextwindowarchitecture.io/schema/dashboard/assembly-event.v1.schema.json",
  "title": "CWA dashboard assembly event",
  "description": "One assemble() call, as the wrapper around a conformant assembler records it: the frozen snapshot and the trace the assembler returned, inside this envelope. The snapshot and the trace are the published shapes and validate against the vendored contract's schemas; the envelope adds what the contract does not have: the service, the assembler, the contract lock, the session and turn, the redaction mode, the payload's hash, size and parts, and the wrapper's timing. A rejected snapshot has no trace, and what was submitted is kept under rejection.snapshot, since it may break the snapshot schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "event_id",
    "recorded_at",
    "service",
    "assembler",
    "contract",
    "redaction_mode",
    "outcome",
    "timings_ms"
  ],
  "properties": {
    "$schema": {
      "const": "cwa-dashboard/assembly-event/v1"
    },
    "event_id": {
      "description": "A ULID: unique, and sortable by the time the wrapper minted it.",
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "recorded_at": {
      "description": "When the wrapper recorded the call, by the wrapper's clock (not the snapshot's assembly_time).",
      "type": "string",
      "format": "date-time"
    },
    "service": {
      "description": "The application process that called assemble().",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonblank"
        },
        "instance": {
          "$ref": "#/$defs/nonblank"
        },
        "environment": {
          "description": "The deployment environment; demo traffic says demo.",
          "$ref": "#/$defs/nonblank"
        }
      }
    },
    "assembler": {
      "description": "The implementation that assembled: its language, as implementations/index.json names it, its package name and its version.",
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "name", "version"],
      "properties": {
        "language": {
          "enum": ["python", "typescript", "go", "rust"]
        },
        "name": {
          "$ref": "#/$defs/nonblank"
        },
        "version": {
          "$ref": "#/$defs/nonblank"
        }
      }
    },
    "contract": {
      "description": "The contract the assembler was built against: the specification repository and commit its vendored lock pins, and the SHA-256 of that lock file's bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "lock_sha256"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "session": {
      "description": "The conversation the call belongs to, and its turn, counted from 0. The contract has no sessions; the wrapper assigns them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "turn_index"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonblank"
        },
        "turn_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "redaction_mode": {
      "description": "What the wrapper did to bodies before emitting the event, by its per-route setting: full keeps them, pii_scrubbed replaces each with its scrubbed text, digest_only with its digest and token count. A mode touches bodies only; every other field of every item is kept (R-DASH-1).",
      "enum": ["full", "pii_scrubbed", "digest_only"]
    },
    "outcome": {
      "description": "assembled: a payload was rendered. refused: the trace records a refusal and there is no payload. rejected: the snapshot failed its checks before assembly and there is no trace.",
      "enum": ["assembled", "refused", "rejected"]
    },
    "snapshot": {
      "description": "The frozen snapshot assemble() was given, with bodies as the redaction mode leaves them. Absent when rejected.",
      "$ref": "https://contextwindowarchitecture.io/schema/snapshot.schema.json"
    },
    "trace": {
      "description": "The trace the assembler returned. Absent when rejected.",
      "$ref": "https://contextwindowarchitecture.io/schema/trace.schema.json"
    },
    "payload": {
      "description": "The rendered payload's SHA-256 (equal to trace.result.hash), its length in UTF-8 bytes, and the parts its published format delimits. Present only when assembled; the payload itself is never emitted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "bytes"],
      "properties": {
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "parts": {
          "description": "The parts the renderer's published payload format delimits, in request order, each by its digest: under cwa-message-blocks/v1 every system, tools and user-content entry; under cwa-messages/v1 every system and tools entry, then the user message's content as one part with no id. Absent when the format delimits none, as under fixture-xml/v1. Comparing consecutive turns' parts shows how much leading content a call reused (docs/otel-semantic-conventions.md, Payload parts).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "sha256", "bytes"],
            "properties": {
              "section": {
                "description": "Where the part sits in the request.",
                "enum": ["system", "tools", "content"]
              },
              "id": {
                "description": "The id of the item the part renders; absent for a part that holds several.",
                "$ref": "#/$defs/nonblank"
              },
              "sha256": {
                "description": "The SHA-256 of the part's text in UTF-8.",
                "$ref": "#/$defs/sha256"
              },
              "bytes": {
                "description": "The length of the part's text in UTF-8 bytes.",
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "rejection": {
      "description": "Why the snapshot was rejected before assembly, as the assembler's checks said it in words, and what was submitted, which may break the snapshot schema. Present only when rejected.",
      "type": "object",
      "additionalProperties": false,
      "required": ["problems", "snapshot"],
      "properties": {
        "problems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "snapshot": {
          "description": "What the application submitted, with bodies as the redaction mode leaves them."
        }
      }
    },
    "timings_ms": {
      "description": "The wrapper's wall-clock time around the whole assemble() call, in milliseconds. Outside the payload hash and not deterministic (R-23); an assembler's own per-stage timings stay in trace.timings.",
      "type": "object",
      "additionalProperties": false,
      "required": ["total"],
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "otel": {
      "description": "The OpenTelemetry span the wrapper recorded the call in.",
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "span_id"],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      }
    },
    "vault": {
      "description": "Reserved for Phase 2 (D8): where a route that opts into the vault deposits bodies by content_sha256, for a reader the policy allows.",
      "type": "object",
      "additionalProperties": false,
      "required": ["base"],
      "properties": {
        "base": {
          "type": "string",
          "format": "uri"
        },
        "kms_key_id": {
          "$ref": "#/$defs/nonblank"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "assembled"
          }
        }
      },
      "then": {
        "required": ["snapshot", "trace", "payload"],
        "properties": {
          "trace": {
            "properties": {
              "refused": {
                "properties": {
                  "bool": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        "not": {
          "required": ["rejection"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "refused"
          }
        }
      },
      "then": {
        "required": ["snapshot", "trace"],
        "properties": {
          "trace": {
            "properties": {
              "refused": {
                "properties": {
                  "bool": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": ["payload"]
            },
            {
              "required": ["rejection"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "required": ["rejection"],
        "not": {
          "anyOf": [
            {
              "required": ["snapshot"]
            },
            {
              "required": ["trace"]
            },
            {
              "required": ["payload"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "redaction_mode": {
            "const": "full"
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "$ref": "#/$defs/fullBodies"
          },
          "rejection": {
            "properties": {
              "snapshot": {
                "$ref": "#/$defs/fullBodies"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "redaction_mode": {
            "const": "digest_only"
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "$ref": "#/$defs/digestOnlyBodies"
          },
          "rejection": {
            "properties": {
              "snapshot": {
                "$ref": "#/$defs/digestOnlyBodies"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "redaction_mode": {
            "const": "pii_scrubbed"
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "$ref": "#/$defs/piiScrubbedBodies"
          },
          "rejection": {
            "properties": {
              "snapshot": {
                "$ref": "#/$defs/piiScrubbedBodies"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonblank": {
      "description": "A string with a character that is not whitespace, by the set the contract's schemas list (conformance/README.md, Blank strings).",
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tokenCounts": {
      "description": "The original body's token count under the snapshot's tokenizer, keyed by its id; empty when the body was not a string.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonblank"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "digestOnlyBody": {
      "description": "A body under digest_only: the SHA-256 of the original (its UTF-8 bytes when a string, else its RFC 8785 serialization) and its token count.",
      "type": "object",
      "additionalProperties": false,
      "required": ["redacted", "content_sha256", "token_counts"],
      "properties": {
        "redacted": {
          "const": "digest_only"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "token_counts": {
          "$ref": "#/$defs/tokenCounts"
        }
      }
    },
    "piiScrubbedBody": {
      "description": "A body under pii_scrubbed: the scrubbed text, and the original's SHA-256 and token count.",
      "type": "object",
      "additionalProperties": false,
      "required": ["redacted", "text", "content_sha256", "token_counts"],
      "properties": {
        "redacted": {
          "const": "pii_scrubbed"
        },
        "text": {
          "type": "string"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "token_counts": {
          "$ref": "#/$defs/tokenCounts"
        }
      }
    },
    "notRedacted": {
      "description": "Any body except a redacted one: a full event carries what the producer emitted.",
      "not": {
        "type": "object",
        "required": ["redacted"],
        "properties": {
          "redacted": {
            "enum": ["digest_only", "pii_scrubbed"]
          }
        }
      }
    },
    "fullBodies": {
      "properties": {
        "batches": {
          "items": {
            "properties": {
              "items": {
                "items": {
                  "properties": {
                    "body": {
                      "$ref": "#/$defs/notRedacted"
                    },
                    "variants": {
                      "items": {
                        "properties": {
                          "body": {
                            "$ref": "#/$defs/notRedacted"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "digestOnlyBodies": {
      "properties": {
        "batches": {
          "items": {
            "properties": {
              "items": {
                "items": {
                  "properties": {
                    "body": {
                      "$ref": "#/$defs/digestOnlyBody"
                    },
                    "variants": {
                      "items": {
                        "properties": {
                          "body": {
                            "$ref": "#/$defs/digestOnlyBody"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "piiScrubbedBodies": {
      "properties": {
        "batches": {
          "items": {
            "properties": {
              "items": {
                "items": {
                  "properties": {
                    "body": {
                      "$ref": "#/$defs/piiScrubbedBody"
                    },
                    "variants": {
                      "items": {
                        "properties": {
                          "body": {
                            "$ref": "#/$defs/piiScrubbedBody"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
