{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextwindowarchitecture.io/schema/dashboard/corpus.v1.schema.json",
  "title": "CWA dashboard corpus",
  "description": "A named, frozen list of events for shadow regression (ADR-0008): each event's id and, when it was assembled or refused, the digest of the snapshot it froze, so a later run replays the same snapshots. Never overwritten.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "created_at", "events"],
  "properties": {
    "$schema": { "const": "cwa-dashboard/corpus/v1" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id"],
        "properties": {
          "event_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "snapshot_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
