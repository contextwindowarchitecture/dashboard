{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextwindowarchitecture.io/schema/dashboard/draft.v1.schema.json",
  "title": "CWA dashboard draft",
  "description": "A route policy or a profile in the making (ADR-0013), kept per author by the API: its kind, the registry entry it started from or none, the route it is for, its tenant, the document as last saved, valid or not, when, and the pull request it was last published to.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "kind", "started_from", "route", "document", "updated_at"],
  "properties": {
    "$schema": { "const": "cwa-dashboard/draft/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$" },
    "kind": { "enum": ["route_policy", "profile"] },
    "started_from": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile"],
          "properties": {
            "profile": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "version": { "type": "integer" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["route_policy"],
          "properties": {
            "route_policy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["route", "version"],
              "properties": {
                "route": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "tenant": {
      "description": "The tenant the draft is kept in (ADR-0012); absent for the default tenant's, as on an event.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "route": { "type": "string", "pattern": "\\S" },
    "document": {},
    "updated_at": { "type": "string", "format": "date-time" },
    "published": {
      "description": "The pull request Publish last opened or updated for the draft (ADR-0014), in the tenant's policy repository; absent until it is published.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "branch", "number", "url", "at"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "path": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
