{
  "name": "@cwa-dashboard/contract",
  "private": true,
  "version": "0.0.0",
  "description": "The CWA contract vendored at a pinned commit, with its generated types, validators and data",
  "type": "module",
  "exports": {
    "./types": "./generated/types.ts",
    "./validators": {
      "types": "./generated/validators.d.ts",
      "default": "./generated/validators.js"
    },
    "./data": "./generated/data.ts",
    "./registry": "./generated/registry.ts",
    "./implementations": "./generated/implementations.ts",
    "./scripts/standalone.mjs": "./scripts/standalone.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.9.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
