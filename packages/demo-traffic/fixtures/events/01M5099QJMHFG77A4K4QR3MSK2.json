        "items": [
          {
            "id": "annual-report-2025#s1",
            "slot": "evidence.knowledge",
            "source": "annual-report-2025",
            "source_version": "final",
            "authority": "reference_only",
            "trust": "verified",
            "freshness": "2026-03-14T00:00:00Z",
            "body": "Revenue grew 11 percent to NOK 4.2 billion, driven by the Nordic payments business, which added 38,000 merchants. Card volumes rose 17 percent while transaction margins narrowed by four basis points under competitive pricing in Sweden and Denmark. Recurring software revenue reached 31 percent of the total, up from 26 percent.",
            "relevance": 0.91,
            "scope": {
              "tenant": "fjord-capital"
            },
            "variants": [
              {
                "id": "annual-report-2025#s1/summary",
                "body": "Revenue +11% to NOK 4.2bn; Nordic payments added 38,000 merchants; margins down 4bp.",
                "method": "summary",
                "lineage": "summarised"
              }
            ]
          },
          {
            "id": "annual-report-2025#s2",
            "slot": "evidence.knowledge",
            "source": "annual-report-2025",
            "source_version": "final",
            "authority": "reference_only",
            "trust": "verified",
            "freshness": "2026-03-14T00:00:00Z",
            "body": "Operating costs rose 9 percent, mainly from 240 new engineering hires and the migration of the core ledger to a cloud provider, which ran three months late. The board expects the migration's double-running costs of NOK 85 million to end in the second quarter of 2026.",
            "relevance": 0.86,
            "scope": {
              "tenant": "fjord-capital"
            },
            "variants": [
              {
                "id": "annual-report-2025#s2/summary",
                "body": "Costs +9% from hiring and a late ledger migration; NOK 85m double-running ends Q2 2026.",
                "method": "summary",
                "lineage": "summarised"
              }
            ]
          },
          {
            "id": "annual-report-2025#s3",
            "slot": "evidence.knowledge",
            "source": "annual-report-2025",
            "source_version": "final",
            "authority": "reference_only",
            "trust": "verified",
            "freshness": "2026-03-14T00:00:00Z",
            "body": "Credit losses on the merchant lending book increased to 1.9 percent of loans from 1.2 percent, concentrated in hospitality merchants in Norway. Provisions were raised by NOK 60 million and new lending to the segment was paused in October.",
            "relevance": 0.84,
            "scope": {
              "tenant": "fjord-capital"
            },
            "variants": [
              {
                "id": "annual-report-2025#s3/summary",
                "body": "Merchant credit losses 1.9% (from 1.2%), Norwegian hospitality; NOK 60m provisions; lending paused.",
                "method": "summary",
                "lineage": "summarised"
              }
            ]
          },
          {
            "id": "annual-report-2025#s4",
            "slot": "evidence.knowledge",
            "source": "annual-report-2025",
            "source_version": "final",
            "authority": "reference_only",
            "trust": "verified",
            "freshness": "2026-03-14T00:00:00Z",
            "body": "The company holds NOK 1.1 billion in cash and an undrawn revolving facility of NOK 500 million. The board proposes a dividend of NOK 2.40 per share and a buyback of up to NOK 300 million over twelve months.",
            "relevance": 0.8,
            "scope": {
              "tenant": "fjord-capital"
            },
            "variants": [
              {
                "id": "annual-report-2025#s4/summary",
                "body": "Cash NOK 1.1bn plus NOK 500m undrawn facility; dividend NOK 2.40; buyback up to NOK 300m.",
                "method": "summary",
                "lineage": "summarised"
              }
            ]
          },
          {
            "id": "annual-report-2025#s5",
            "slot": "evidence.knowledge",
            "source": "annual-report-2025",
            "source_version": "final",
            "authority": "reference_only",
            "trust": "verified",
            "freshness": "2026-03-14T00:00:00Z",
            "body": "Regulatory risk centres on the revised Payment Services Directive, which will require changes to strong customer authentication flows. The company estimates compliance costs of NOK 40 million across 2026 and 2027.",
            "relevance": 0.78,
            "scope": {
              "tenant": "fjord-capital"
            },
            "variants": [
              {
                "id": "annual-report-2025#s5/summary",
                "body": "PSD revision needs SCA changes; NOK 40m compliance cost over 2026-2027.",
                "method": "summary",
                "lineage": "summarised"
              }
            ]
          },
          {
            "id": "annual-report-2025#s6",
            "slot": "evidence.knowledge",
            "source": "annual-report-2025",
            "source_version": "final",
            "authority": "reference_only",
            "trust": "verified",
            "freshness": "2026-03-14T00:00:00Z",
            "body": "Employee engagement scored 78 out of 100 in the annual survey, and voluntary attrition fell to 8 percent. The company opened an office in Tallinn with 60 staff.",
            "relevance": 0.62,
            "scope": {
              "tenant": "fjord-capital"
            },
            "variants": [
              {
                "id": "annual-report-2025#s6/summary",
                "body": "Engagement 78/100; attrition 8%; new Tallinn office with 60 staff.",
                "method": "summary",
                "lineage": "summarised"
              }
            ]
          }
        ],
